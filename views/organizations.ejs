<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>

    <div class="organizations-grid" style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px;">
        <% organizations.forEach(organization => { %>
            <article class="org-card" style="border: 1px solid #ccc; padding: 15px; border-radius: 8px; max-width: 300px;">
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" style="width: 100%; height: auto; border-radius: 4px;" />
                <h2><%= organization.name %></h2>
                <p><%= organization.description %></p>
                <p><strong>Contact:</strong> <%= organization.contact_email %></p>
            </article>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>